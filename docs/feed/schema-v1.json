{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Repo_Dex/feed/schema-v1.json",
  "title": "Repo_Dex public portfolio evidence feed v1",
  "description": "Public-only, read-only scan with pinned evidence, progressive source coverage, hypothesis review and a separately published scan-status receipt. V1 fields remain backward-compatible.",
  "type": "object",
  "required": [
    "schema",
    "parser_version",
    "owner",
    "generated_at",
    "source",
    "inventory",
    "repositories",
    "relationships",
    "opportunities",
    "observations",
    "delta",
    "evidence_ladder",
    "content_sha256",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "repo-dex-feed/v1"
    },
    "parser_version": {
      "type": "string"
    },
    "owner": {
      "const": "westkitty"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "visibility",
        "read_only"
      ],
      "properties": {
        "visibility": {
          "const": "public-only"
        },
        "read_only": {
          "const": true
        }
      }
    },
    "inventory": {
      "type": "object",
      "required": [
        "public_repositories",
        "complete",
        "inspected_repositories",
        "sampling_limit",
        "source_errors",
        "historical_cached_repositories"
      ],
      "properties": {
        "public_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "const": true
        },
        "inspected_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "historical_cached_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "sampling_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "source_errors": {
          "type": "array"
        },
        "cumulative_source_repositories": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "visibility",
          "metadata_sha256",
          "inspection"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "visibility": {
            "const": "public"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/westkitty/"
          },
          "inspection": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "inspected",
                  "partial",
                  "error",
                  "not-selected",
                  "cached"
                ]
              }
            }
          },
          "aliases": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "a",
          "b",
          "type",
          "status",
          "evidence_level",
          "explanation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "integer"
          },
          "b": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "documented",
              "hypothesis"
            ]
          },
          "evidence_level": {
            "enum": [
              "described",
              "located",
              "exercised",
              "verified",
              "transferred"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "type",
          "title",
          "evidence",
          "experiment"
        ],
        "properties": {
          "status": {
            "const": "hypothesis"
          },
          "evidence_level": {
            "enum": [
              "described",
              "located"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "tier": {
                "type": "string"
              },
              "confidence": {
                "const": "untested-hypothesis"
              },
              "beneficiary_repository_id": {
                "type": "integer"
              },
              "skeptical_counterpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptance_test": {
                "type": "string"
              },
              "rejection_criterion": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "array"
    },
    "delta": {
      "type": "object",
      "required": [
        "kind",
        "new",
        "removed",
        "renamed",
        "changed",
        "archived"
      ],
      "properties": {
        "kind": {
          "enum": [
            "baseline",
            "incremental"
          ]
        }
      }
    },
    "evidence_ladder": {
      "const": [
        "described",
        "located",
        "exercised",
        "verified",
        "transferred"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability_genomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository_id",
          "kind",
          "token",
          "evidence_level",
          "freshness",
          "source",
          "constraint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16,64}$"
          },
          "repository_id": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "evidence_level": {
            "enum": [
              "described",
              "located"
            ]
          },
          "freshness": {
            "enum": [
              "historical",
              "sampled-head"
            ]
          },
          "source": {
            "type": "object"
          },
          "constraint": {
            "type": "string"
          }
        }
      }
    }
  }
}
